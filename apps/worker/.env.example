API_BASE_URL="http://localhost:3001"
POLL_INTERVAL_SECONDS=120

# --- Atlassian Jira MCP (preferred) ---
# Your remote MCP endpoint (matches Cursor's mcp.json for Atlassian)
ATLASSIAN_MCP_URL="https://mcp.atlassian.com/v1/mcp"

# Cloud ID (UUID) OR site URL (e.g. https://your-domain.atlassian.net)
ATLASSIAN_CLOUD_ID_OR_SITE_URL="https://your-domain.atlassian.net"

# Optional: headers for Atlassian MCP (JSON string)
# If your org enables API-token auth for Atlassian MCP, set ONE of:
# - Personal API token (Basic): Authorization: Basic base64(email:api_token)
# - Service account API key (Bearer): Authorization: Bearer <api_key>
# Examples:
# ATLASSIAN_MCP_HEADERS_JSON='{"Authorization":"Basic BASE64_ENCODED_EMAIL_AND_TOKEN"}'
# ATLASSIAN_MCP_HEADERS_JSON='{"Authorization":"Bearer YOUR_SERVICE_ACCOUNT_API_KEY"}'

# OAuth 2.1 (recommended if API-token auth does not expose Jira tools)
# 1) Set ATLASSIAN_MCP_USE_OAUTH=true
# 2) Run: node apps/worker/dist/mcpOauthLogin.js
ATLASSIAN_MCP_USE_OAUTH=false
ATLASSIAN_MCP_OAUTH_CACHE_PATH="apps/worker/.atlassian-mcp-oauth.json"
ATLASSIAN_MCP_OAUTH_REDIRECT_URL="http://127.0.0.1:3344/callback"

# --- Repo / PR automation (for code changes) ---
# Repo root (defaults to process.cwd() if unset)
# REPO_ROOT="C:/Users/PratikSonigra/Projects/RATIFAI Jira Integration"
PR_BASE_BRANCH="develop"
PR_REMOTE="origin"

# Optional: command to run tests before committing
# RUN_TESTS_COMMAND="npm test"

# If the worker can't find `gh` (spawn gh ENOENT), set an explicit path to gh.exe:
# GH_PATH="C:/Program Files/GitHub CLI/gh.exe"

# --- Legacy Jira REST fallback (only if not using MCP) ---
# JIRA_BASE_URL="https://your-domain.atlassian.net"
# JIRA_EMAIL="you@company.com"
# JIRA_API_TOKEN="..."

